import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read image
image = cv2.imread("dog.jpg")

# Check if image was loaded
if image is None:
    print("Error: Image not found!")
else:

    # Split into B, G, R channels
    B, G, R = cv2.split(image)

    # Convert to float
    R = R.astype(float)
    G = G.astype(float)
    B = B.astype(float)

    # Input weights
    wr = float(input("Enter weight for R: "))
    wg = float(input("Enter weight for G: "))
    wb = float(input("Enter weight for B: "))

    # Check weights
    if (0 <= wr <= 1 and
        0 <= wg <= 1 and
        0 <= wb <= 1 and
        abs(wr + wg + wb - 1) < 0.0001):

        # Weighted grayscale
        gray_weighted = (R * wr) + (G * wg) + (B * wb)

        # Convert to uint8
        gray_weighted = gray_weighted.astype(np.uint8)

        # Display
        plt.imshow(gray_weighted, cmap="gray")
        plt.title("Grayscale - Weighted")
        plt.axis("off")
        plt.show()

    else:
        print("Invalid weights!")
        print("Each weight must be between 0 and 1.")
        print("The sum of all weights must be equal to 1.")
