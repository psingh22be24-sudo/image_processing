import cv2
import numpy as np


image = cv2.imread("image.jpg")


B, G, R = cv2.split(image)


R = R.astype(float)
G = G.astype(float)
B = B.astype(float)



# Mean average of R, G and B

gray_mean = (R + G + B) / 3


gray_mean = gray_mean.astype(np.uint8)


cv2.imshow("Grayscale - Mean Average", gray_mean)
